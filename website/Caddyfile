{
    admin off
    auto_https off
}
:{$PORT:8080} {
    root * /srv
    encode zstd gzip
    respond /health "ok" 200
    @legacy path /website /website/*
    route @legacy {
        uri strip_prefix /website
        redir {uri} 301
    }
    # The app: the latest GitHub release of nomdelasociete/skilli
    # (script/release/publish.sh). Sparkle's feed lives there too; the app
    # asks skil.li for it, so the files can move without an app update.
    redir /download https://github.com/nomdelasociete/skilli/releases/latest/download/skil.li.dmg 302
    redir /appcast.xml https://github.com/nomdelasociete/skilli/releases/latest/download/appcast.xml 302
    header Cache-Control "public, max-age=0, must-revalidate"
    @downloads path /skillies/files/*
    header @downloads Content-Disposition "attachment"
    file_server
}
